{
  "_comment": "BENCHMARK COMPARATIVO WAI-illustrious-SDXL. Multi-referencia via IP-Adapter (custom node cubiq/ComfyUI_IPAdapter_plus). IMPORTANTE: FLUX faz multi-referencia pelo mecanismo proprio (ReferenceLatent); WAI faz por IP-Adapter. Os mecanismos NAO sao equivalentes internamente \u2014 a comparacao e sobre o RESULTADO VISUAL com as mesmas referencias de entrada. Loaders explicitos (IPAdapterModelLoader + CLIPVisionLoader) em vez do IPAdapterUnifiedLoader: o unificado resolve arquivo por preset e pode baixar peso sozinho, o que quebraria o pinning por SHA256. GERACAO a partir de EmptyLatentImage, nao img2img: o IP-Adapter E o mecanismo de referencia aqui. Usar img2img junto faria full_body entrar duas vezes (uma como latente inicial, outra como embed) e contaminaria o peso declarado de cada referencia. [HUMAN REVIEW REQUIRED] || VERSAO v1 = UMA referencia (full_body). Usada nas Runs 001 e 002. NAO ha combine: com uma referencia so, combinar seria ruido. O peso de full_body continua explicito e registrado.",
  "_reference_count": 1,
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "WAI-illustrious-SDXL"
    },
    "inputs": {
      "ckpt_name": "%%CKPT_NAME%%"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Prompt positivo (identico ao do FLUX)"
    },
    "inputs": {
      "text": "%%PROMPT%%",
      "clip": [
        "1",
        1
      ]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Prompt negativo (declarado pelo autor)"
    },
    "inputs": {
      "text": "%%NEGATIVE_PROMPT%%",
      "clip": [
        "1",
        1
      ]
    }
  },
  "10": {
    "class_type": "IPAdapterModelLoader",
    "_meta": {
      "title": "IP-Adapter SDXL (arquivo pinado)"
    },
    "inputs": {
      "ipadapter_file": "%%IPADAPTER_FILE%%"
    }
  },
  "11": {
    "class_type": "CLIPVisionLoader",
    "_meta": {
      "title": "CLIP Vision (encoder das referencias)"
    },
    "inputs": {
      "clip_name": "%%CLIP_VISION_FILE%%"
    }
  },
  "30": {
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Latente vazio (SDXL nativo)"
    },
    "inputs": {
      "width": "%%WIDTH%%",
      "height": "%%HEIGHT%%",
      "batch_size": 1
    }
  },
  "40": {
    "class_type": "KSampler",
    "_meta": {
      "title": "Sampler"
    },
    "inputs": {
      "seed": "%%SEED%%",
      "steps": "%%STEPS%%",
      "cfg": "%%CFG%%",
      "sampler_name": "%%SAMPLER%%",
      "scheduler": "%%SCHEDULER%%",
      "denoise": "%%DENOISE%%",
      "model": [
        "20",
        0
      ],
      "positive": [
        "2",
        0
      ],
      "negative": [
        "3",
        0
      ],
      "latent_image": [
        "30",
        0
      ]
    }
  },
  "41": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode"
    },
    "inputs": {
      "samples": [
        "40",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "42": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Output"
    },
    "inputs": {
      "images": [
        "41",
        0
      ],
      "filename_prefix": "%%OUTPUT_PREFIX%%"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Referencia 1: full_body"
    },
    "inputs": {
      "image": "%%REF_FULL_BODY%%"
    }
  },
  "12": {
    "class_type": "IPAdapterEncoder",
    "_meta": {
      "title": "Encode full_body (peso %%WEIGHT_FULL_BODY%%)"
    },
    "inputs": {
      "ipadapter": [
        "10",
        0
      ],
      "image": [
        "4",
        0
      ],
      "weight": "%%WEIGHT_FULL_BODY%%",
      "clip_vision": [
        "11",
        0
      ]
    }
  },
  "20": {
    "class_type": "IPAdapterEmbeds",
    "_meta": {
      "title": "Aplicar embed ao modelo"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "ipadapter": [
        "10",
        0
      ],
      "pos_embed": [
        "12",
        0
      ],
      "neg_embed": [
        "12",
        1
      ],
      "weight": 1.0,
      "weight_type": "%%WEIGHT_TYPE%%",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "%%EMBEDS_SCALING%%"
    }
  }
}
