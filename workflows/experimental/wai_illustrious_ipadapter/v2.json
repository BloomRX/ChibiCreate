{
  "_comment": "WAI CHIBI EXPERIMENT LAB. IMG2IMG REAL: o latente inicial vem SEMPRE de full_body.png via LoadImage -> VAEEncode -> KSampler. NUNCA usar EmptyLatentImage aqui: isso viraria txt2img e descartaria a personagem original. O mecanismo de referencia atua ADICIONALMENTE sobre o MODEL, nao sobre o latente. Resolucao herdada da imagem-fonte (sem resize: redimensionar deformaria a arte). VAE integrado ao checkpoint (saida 2). || v2 = MODO 3 REFS. full_body.png tem DOIS PAPEIS: imagem inicial do img2img E referencia do IP-Adapter (dual_role). Encoder x3 + CombineEmbeds (em vez de IPAdapterAdvanced em serie) para que o peso de CADA referencia seja explicito e auditavel. Sao precisos DOIS CombineEmbeds: um para os embeds positivos (saida 0 de cada encoder) e outro para os negativos (saida 1).",
  "_pipeline": "img2img",
  "_reference_count": 3,
  "_primary_image_role": "source_image",
  "_mode": "3_REF_FULL_BODY_FACE_OUTFIT",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "WAI-illustrious-SDXL v17.0 (VAE integrado)"
    },
    "inputs": {
      "ckpt_name": "%%CKPT_NAME%%"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positivo (preset generico)"
    },
    "inputs": {
      "text": "%%PROMPT%%",
      "clip": [
        "1",
        1
      ]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negativo"
    },
    "inputs": {
      "text": "%%NEGATIVE_PROMPT%%",
      "clip": [
        "1",
        1
      ]
    }
  },
  "4": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "full_body.png - IMAGEM DE PARTIDA do img2img"
    },
    "inputs": {
      "image": "%%REF_FULL_BODY%%"
    }
  },
  "5": {
    "class_type": "VAEEncode",
    "_meta": {
      "title": "full_body -> latente inicial"
    },
    "inputs": {
      "pixels": [
        "4",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "41": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode"
    },
    "inputs": {
      "samples": [
        "40",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "42": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Output"
    },
    "inputs": {
      "images": [
        "41",
        0
      ],
      "filename_prefix": "%%OUTPUT_PREFIX%%"
    }
  },
  "6": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Referencia IP-Adapter: face"
    },
    "inputs": {
      "image": "%%REF_FACE%%"
    }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Referencia IP-Adapter: outfit"
    },
    "inputs": {
      "image": "%%REF_OUTFIT%%"
    }
  },
  "10": {
    "class_type": "IPAdapterModelLoader",
    "_meta": {
      "title": "IP-Adapter SDXL (arquivo pinado)"
    },
    "inputs": {
      "ipadapter_file": "%%IPADAPTER_FILE%%"
    }
  },
  "11": {
    "class_type": "CLIPVisionLoader",
    "_meta": {
      "title": "CLIP Vision ViT-H"
    },
    "inputs": {
      "clip_name": "%%CLIP_VISION_FILE%%"
    }
  },
  "12": {
    "class_type": "IPAdapterEncoder",
    "_meta": {
      "title": "Encode full_body (peso %%WEIGHT_FULL_BODY%%)"
    },
    "inputs": {
      "ipadapter": [
        "10",
        0
      ],
      "image": [
        "4",
        0
      ],
      "weight": "%%WEIGHT_FULL_BODY%%",
      "clip_vision": [
        "11",
        0
      ]
    }
  },
  "13": {
    "class_type": "IPAdapterEncoder",
    "_meta": {
      "title": "Encode face (peso %%WEIGHT_FACE%%)"
    },
    "inputs": {
      "ipadapter": [
        "10",
        0
      ],
      "image": [
        "6",
        0
      ],
      "weight": "%%WEIGHT_FACE%%",
      "clip_vision": [
        "11",
        0
      ]
    }
  },
  "14": {
    "class_type": "IPAdapterEncoder",
    "_meta": {
      "title": "Encode outfit (peso %%WEIGHT_OUTFIT%%)"
    },
    "inputs": {
      "ipadapter": [
        "10",
        0
      ],
      "image": [
        "7",
        0
      ],
      "weight": "%%WEIGHT_OUTFIT%%",
      "clip_vision": [
        "11",
        0
      ]
    }
  },
  "15": {
    "class_type": "IPAdapterCombineEmbeds",
    "_meta": {
      "title": "Combinar embeds POSITIVOS"
    },
    "inputs": {
      "embed1": [
        "12",
        0
      ],
      "embed2": [
        "13",
        0
      ],
      "embed3": [
        "14",
        0
      ],
      "method": "%%COMBINE_METHOD%%"
    }
  },
  "16": {
    "class_type": "IPAdapterCombineEmbeds",
    "_meta": {
      "title": "Combinar embeds NEGATIVOS"
    },
    "inputs": {
      "embed1": [
        "12",
        1
      ],
      "embed2": [
        "13",
        1
      ],
      "embed3": [
        "14",
        1
      ],
      "method": "%%COMBINE_METHOD%%"
    }
  },
  "20": {
    "class_type": "IPAdapterEmbeds",
    "_meta": {
      "title": "Aplicar embeds ao MODEL (nao ao latente)"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "ipadapter": [
        "10",
        0
      ],
      "pos_embed": [
        "15",
        0
      ],
      "neg_embed": [
        "16",
        0
      ],
      "weight": "%%IPADAPTER_WEIGHT%%",
      "weight_type": "%%WEIGHT_TYPE%%",
      "start_at": "%%START_AT%%",
      "end_at": "%%END_AT%%",
      "embeds_scaling": "%%EMBEDS_SCALING%%"
    }
  },
  "40": {
    "class_type": "KSampler",
    "_meta": {
      "title": "img2img + 3 refs (denoise < 1.0)"
    },
    "inputs": {
      "seed": "%%SEED%%",
      "steps": "%%STEPS%%",
      "cfg": "%%CFG%%",
      "sampler_name": "%%SAMPLER%%",
      "scheduler": "%%SCHEDULER%%",
      "denoise": "%%DENOISE%%",
      "model": [
        "20",
        0
      ],
      "positive": [
        "2",
        0
      ],
      "negative": [
        "3",
        0
      ],
      "latent_image": [
        "5",
        0
      ]
    }
  }
}
