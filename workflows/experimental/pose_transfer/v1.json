{
  "_comment": "POSE TRANSFER v1 (ADR-007, EXPERIMENTAL). Derivado de flux2_klein_edit/v2.json. INPUT_IMAGE = frame do mannequin (POSE). INPUT_IMAGE_2 = chibi master (IDENTIDADE). INPUT_IMAGE_3 = ref extra opcional. A ordem importa: o primeiro ReferenceLatent e a pose. NAO promove a estrategia (A) do ADR-002 a producao.",
  "1": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "FLUX.2 klein 4B (diffusion model)"
    },
    "inputs": {
      "unet_name": "%%UNET_NAME%%",
      "weight_dtype": "%%WEIGHT_DTYPE%%"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Text encoder (Qwen3-4B)"
    },
    "inputs": {
      "clip_name": "%%CLIP_NAME%%",
      "type": "flux2",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "VAE"
    },
    "inputs": {
      "vae_name": "%%VAE_NAME%%"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Referencia 1: full_body"
    },
    "inputs": {
      "image": "%%INPUT_IMAGE%%",
      "upload": "image"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Prompt positivo"
    },
    "inputs": {
      "text": "%%PROMPT%%",
      "clip": [
        "2",
        0
      ]
    }
  },
  "6": {
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Referencia -> latente"
    },
    "inputs": {
      "pixels": [
        "4",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "7": {
    "class_type": "ReferenceLatent",
    "_meta": {
      "title": "Injeta full_body (inicio da cadeia)"
    },
    "inputs": {
      "conditioning": [
        "5",
        0
      ],
      "latent": [
        "6",
        0
      ]
    }
  },
  "8": {
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "Negativo (FLUX nao usa prompt negativo real)"
    },
    "inputs": {
      "conditioning": [
        "5",
        0
      ]
    }
  },
  "9": {
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "Canvas de saida"
    },
    "inputs": {
      "width": "%%WIDTH%%",
      "height": "%%HEIGHT%%",
      "batch_size": 1
    }
  },
  "10": {
    "class_type": "KSampler",
    "_meta": {
      "title": "Sampler (cfg DEVE ser 1.0) - positive <- 18"
    },
    "inputs": {
      "seed": "%%SEED%%",
      "steps": "%%STEPS%%",
      "cfg": "%%CFG%%",
      "sampler_name": "%%SAMPLER%%",
      "scheduler": "%%SCHEDULER%%",
      "denoise": "%%DENOISE%%",
      "model": [
        "1",
        0
      ],
      "positive": [
        "18",
        0
      ],
      "negative": [
        "8",
        0
      ],
      "latent_image": [
        "9",
        0
      ]
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode"
    },
    "inputs": {
      "samples": [
        "10",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Output"
    },
    "inputs": {
      "images": [
        "11",
        0
      ],
      "filename_prefix": "%%OUTPUT_PREFIX%%"
    }
  },
  "13": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Referencia 2: face"
    },
    "inputs": {
      "image": "%%INPUT_IMAGE_2%%",
      "upload": "image"
    }
  },
  "14": {
    "class_type": "VAEEncode",
    "_meta": {
      "title": "face -> latente"
    },
    "inputs": {
      "pixels": [
        "13",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "15": {
    "class_type": "ReferenceLatent",
    "_meta": {
      "title": "Injeta face (encadeado apos full_body)"
    },
    "inputs": {
      "conditioning": [
        "7",
        0
      ],
      "latent": [
        "14",
        0
      ]
    }
  },
  "16": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Referencia 3: outfit"
    },
    "inputs": {
      "image": "%%INPUT_IMAGE_3%%",
      "upload": "image"
    }
  },
  "17": {
    "class_type": "VAEEncode",
    "_meta": {
      "title": "outfit -> latente"
    },
    "inputs": {
      "pixels": [
        "16",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "18": {
    "class_type": "ReferenceLatent",
    "_meta": {
      "title": "Injeta outfit (fim da cadeia)"
    },
    "inputs": {
      "conditioning": [
        "15",
        0
      ],
      "latent": [
        "17",
        0
      ]
    }
  },
  "_slots": {
    "INPUT_IMAGE": "pose_frame",
    "INPUT_IMAGE_2": "chibi_master",
    "INPUT_IMAGE_3": "ref_opcional"
  }
}
